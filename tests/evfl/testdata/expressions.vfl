# EVFL mathematical expressions

# Basic arithmetic
[view1(100+50)]
[view2(200-50)]
[view3(50*2)]
[view4(200/2)]

# Complex expressions
H:|[margin]-[content(100%-40)]-[margin]|

# Nested expressions
[calculated((100+50)*2)]

# View attribute references
[view1(view2.width)]
[view3(view4.height+20)]

# Percentage in expressions
[dynamic(50%+20)]
[responsive(100%-60)]

# Combined with priorities
[flex(100%-40@750)]